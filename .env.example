# Agent service
AGENT_HOST=0.0.0.0
AGENT_PORT=8091
AGENT_DEBUG=0

# Runtime files
AGENT_RUNTIME_DIR=runtime
AGENT_BOM_FILE=data/bom.sample.json

# Perception tools
# Example: http://192.168.1.10:8090/ocr
AGENT_OCR_ENDPOINT=
AGENT_SHAPE_ENDPOINT=
AGENT_MIN_OCR_CONFIDENCE=0.75

# Mock values used when perception endpoints are not configured
AGENT_MOCK_OCR_TEXT=304L-DN500
AGENT_MOCK_OCR_CONFIDENCE=0.85
AGENT_MOCK_SHAPE_LABEL=pipe
AGENT_MOCK_SHAPE_CONFIDENCE=0.82

# External action tools
AGENT_ERP_ENDPOINT=
AGENT_SIMULATION_ENDPOINT=

# Alerts: set dry run to 0 only after the webhook is tested
AGENT_ALERT_WEBHOOK=
AGENT_ALERT_CHANNEL=generic
AGENT_ALERT_DRY_RUN=1

# Local LLM boundary, reserved for Qwen/OpenAI-compatible service
AGENT_LLM_ENDPOINT=
AGENT_LLM_MODEL=qwen-14b-industrial
AGENT_LLM_API_KEY=
AGENT_SEMANTIC_CORRECTION_ENABLED=1
AGENT_SEMANTIC_CORRECTION_REQUIRED=1
AGENT_SEMANTIC_CORRECTION_MIN_CONFIDENCE=0.70

# CSV text guard. "\t" is converted to a real tab prefix to prevent Office scientific notation.
AGENT_CSV_TEXT_GUARD=\t
